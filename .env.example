# Names only. Never commit values.
NODE_ENV=development

# Brand (see packages/core/src/brand.ts)
NEXT_PUBLIC_BRAND_NAME=LEGACY
NEXT_PUBLIC_BRAND_LEGAL_NAME=Legacy Protocol

# Platform role: ATTESTOR_ONLY | COSIGNER   (CUSTODIAN is not implemented)
PLATFORM_ROLE=ATTESTOR_ONLY

# Attestation signing — in production these resolve to an HSM/KMS key reference, never a raw key
ORACLE_KMS_KEY_ID=
ORACLE_TRANSPARENCY_LOG_KEY_ID=

# Persistence (unused in demo mode)
DATABASE_URL=
REDIS_URL=

# Chain RPCs — read-only endpoints
BITCOIN_RPC_URL=
ETHEREUM_RPC_URL=
SOLANA_RPC_URL=

# Demo mode: runs entirely in-memory, no network, no keys
DEMO_MODE=true
